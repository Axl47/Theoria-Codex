FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517 AS downloader

ARG LLAMA_RELEASE=b10775
ARG LLAMA_ARCHIVE_SHA256=faac52e16e5749713d33531ab7e4161fd0f09e7f2dccb4ed7527162d4c3bd103
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location \
      "https://github.com/ggml-org/llama.cpp/releases/download/${LLAMA_RELEASE}/llama-${LLAMA_RELEASE}-bin-ubuntu-x64.tar.gz" \
      --output /tmp/llama.tar.gz \
    && echo "${LLAMA_ARCHIVE_SHA256}  /tmp/llama.tar.gz" | sha256sum --check --strict \
    && mkdir /opt/llama \
    && tar --extract --gzip --file /tmp/llama.tar.gz --directory /opt/llama --strip-components 1

FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates libcurl4t64 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 llama \
    && mkdir /models \
    && chown llama:llama /models
COPY --from=downloader /opt/llama /opt/llama

ENV LD_LIBRARY_PATH=/opt/llama
USER llama
ENTRYPOINT ["/opt/llama/llama-server"]
