{
  "threshold": 0.6,
  "minLines": 12,
  "minTokens": 80,
  "reporters": [
    "console",
    "json"
  ],
  "output": "build/reports/jscpd",
  "pattern": "**/*.kt",
  "ignore": [
    "**/build/**",
    "**/.gradle/**",
    "**/.kotlin/**",
    "**/src/test/**",
    "**/src/androidTest/**",
    "**/src/testFixtures/**"
  ],
  "ignorePattern": [
    "import [a-zA-Z0-9_.]+"
  ]
}
